server {
    listen ${PORT};
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;
    # Behind the Cloudflare Tunnel the container's own port/scheme are wrong
    # for clients; keep redirects (e.g. /welcome -> /welcome/) relative.
    absolute_redirect off;

    # SPA routing - serve index.html for all routes
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Marketing page (public/welcome/index.html). Short cache so copy edits
    # show up on the next visit.
    location = /welcome {
        return 301 /welcome/;
    }
    location = /welcome/ {
        try_files /welcome/index.html =404;
        add_header Cache-Control "no-cache";
    }

    # PWA control files must never be long-cached or updates strand clients.
    # Exact-match locations take precedence over the regex cache block below.
    location = /service-worker.js {
        add_header Cache-Control "no-cache";
    }
    location = /manifest.json {
        add_header Cache-Control "no-cache";
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript;
}
