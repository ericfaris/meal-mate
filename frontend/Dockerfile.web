# Build stage
FROM node:26-alpine AS builder
WORKDIR /app

ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
# Repo-root version.json (compose `additional_contexts: repo`) is the version
# source: vite.config.mts reads ../version.json and inject-pwa.js reads
# ../../version.json, both resolving to /version.json from /app.
COPY --from=repo version.json /version.json

COPY package*.json .npmrc ./
RUN npm ci
COPY . .
RUN npm run build

# Vite copies public/ (manifest, service worker, icons, fonts) into dist/.
# Inject the manifest link + SW registration into index.html and stamp
# APP_VERSION into the SW cache name.
RUN node scripts/inject-pwa.js

# Production stage
FROM nginx:alpine
RUN apk update && apk upgrade --no-cache
# Optional: only feeds the image label (lab-deploy.sh passes it).
ARG APP_VERSION=unknown

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf.template /etc/nginx/templates/default.conf.template

LABEL org.opencontainers.image.version="${APP_VERSION}"
LABEL org.opencontainers.image.title="Meal Mate Web"

# nginx listens on ${PORT}, default 80; the lab compose maps host 8600 -> 80.
ENV PORT=80
EXPOSE ${PORT}
CMD ["nginx", "-g", "daemon off;"]
