# Build stage
FROM node:26-alpine AS builder
WORKDIR /app

ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
# vite.config.mts bakes these into the bundle (Settings screen version).
ARG APP_VERSION=dev
ARG BUILD_NUMBER=0
ENV APP_VERSION=${APP_VERSION} BUILD_NUMBER=${BUILD_NUMBER}

COPY package*.json .npmrc ./
RUN npm ci
COPY . .
RUN npm run build

# Vite copies public/ (manifest, service worker, icons, fonts) into dist/.
# Inject the manifest link + SW registration into index.html and stamp
# APP_VERSION into the SW cache name.
RUN node scripts/inject-pwa.js

# Production stage
FROM nginx:alpine
RUN apk update && apk upgrade --no-cache
ARG APP_VERSION=1.0.0
ARG BUILD_NUMBER=1

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf.template /etc/nginx/templates/default.conf.template

LABEL org.opencontainers.image.version="${APP_VERSION}"
LABEL org.opencontainers.image.title="Meal Mate Web"

# nginx listens on ${PORT}, default 80; the lab compose maps host 8600 -> 80.
ENV PORT=80
EXPOSE ${PORT}
CMD ["nginx", "-g", "daemon off;"]
